# Postgres connection string (Neon). If unset, an embedded demo database is used
# that resets whenever the server restarts.
DATABASE_URL=
# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Secret Vercel Cron sends to /api/cron/reminders
CRON_SECRET=
# Display name of the platform
APP_NAME=Vernovi GRC
